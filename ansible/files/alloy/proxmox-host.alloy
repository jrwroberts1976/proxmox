loki.write "default" {
    endpoint {
        url = "http://192.168.2.242:3100/loki/api/v1/push"
    }
}

loki.relabel "journal" {
    forward_to = [loki.write.default.receiver]

    rule {
        target_label = "job"
        replacement  = "systemd-journal"
    }
}

loki.source.journal "system" {
    labels = {
        host = "PROXMOX",
        role = "proxmox-host",
    }

    forward_to = [loki.relabel.journal.receiver]
}
